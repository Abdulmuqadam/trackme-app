# Application
NODE_ENV=development
APP_PORT=3010

# Database (MySQL via Sequelize)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=trackme_db
DB_DIALECT=mysql

# Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# CORS – set to your frontend origin in production (e.g. https://app.example.com)
CORS_ORIGIN=*

# Geolocation
# Maximum radius (km) to search for nearby facilitators (default: 15)
FACILITATOR_RADIUS_KM=15

# Application
NODE_ENV=development
APP_PORT=3010

# Database (MySQL via Sequelize)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=trackme_db
DB_DIALECT=mysql

# Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# CORS – set to your frontend origin in production (e.g. https://app.example.com)
CORS_ORIGIN=*

# Geolocation
# Maximum radius (km) to search for nearby facilitators (default: 15)
FACILITATOR_RADIUS_KM=15

# AWS S3 – audio file storage (Task 4)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=trackme-audio-prod

# Sentry – error monitoring (Task 5)
# Get your DSN from https://sentry.io after creating a Node.js project
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Organization signup configuration
TRIAL_PERIOD_DAYS=14
DASHBOARD_BASE_URL=https://{subdomain}.trackme.app/dashboard

# Stripe – billing (Task 11)
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
